#!/bin/sh
# postinst (doc 01 §7 Security, doc 04 §2, Q44). Creates the `hoserva`
# group — empty, root-equivalent by design, exactly like the `docker`
# group (Q44) — and the `hoserva-apps` system user pinned to UID 99
# (Q26) — and nothing else of its own: no data disk under /mnt is ever
# touched here, and the machine key at /etc/hoserva/secret.key is
# deliberately NOT created here. It is generated once, atomically, by
# hoservad's own first start (internal/auth.LoadOrGenerateMachineKey),
# which also records a check value against the database — a database
# that does not exist yet at install time, and doc 01 §7 requires no
# default credential-like material to exist before setup runs (Q28's
# "Implementation note (#22)": generated at first start, not at
# install). Pre-creating it here would duplicate that already-atomic,
# already-tested logic in a second place, in shell, for no benefit.
set -e

# HOSERVA_TEST_ROOT lets packaging/test-postinst-smartd-mask.sh exercise
# this exact script's file writes against a throwaway tree instead of a
# real root — it is never set outside that test, exactly like postrm's
# own HOSERVA_TEST_ROOT.
root="${HOSERVA_TEST_ROOT:-}"

case "$1" in
  configure)
    if ! getent group hoserva >/dev/null 2>&1; then
      addgroup --quiet --system hoserva
    fi

    # hoserva-apps (Q26): a system user pinned to UID 99, so migrated
    # Unraid data (conventionally owned nobody:users, 99:100) and
    # converted templates that pass PUID=99 PGID=100 (doc 04 §5) keep
    # working with no ownership rewrite. Created only when UID 99 is
    # free on this host; a UID already taken by a different account is
    # reported, never overridden, and an existing hoserva-apps account
    # (an earlier install or reconfigure) is left alone. `users` (GID
    # 100) is Debian's own base-passwd system group — already present
    # on every install — so it needs no creation here.
    if getent passwd hoserva-apps >/dev/null 2>&1; then
      : # already created by an earlier install or reconfigure
    elif getent passwd 99 >/dev/null 2>&1; then
      echo "hoserva: UID 99 is already used by another account; hoserva-apps was not created. Templates and migrated data that assume UID 99 (Unraid's PUID=99/nobody) may need remapping on this host." >&2
    else
      adduser --quiet --system --no-create-home --uid 99 --ingroup users \
        --shell /usr/sbin/nologin \
        --comment "Hoserva template UID pin (Q26)" \
        hoserva-apps
    fi

    # smartmontools (issue #161's own Depends: addition) is a dependency
    # configured before this script runs (dpkg configures dependencies
    # first), and its own postinst unconditionally enables and starts
    # smartmontools.service (smartd) on install. smartd then runs its own
    # independent periodic SMART scan on Debian's default cadence — one
    # of doc 08 §1's own named spindown-wake culprits, and completely
    # separate from LinuxProvider.SMART/.Spindown's on-demand
    # `smartctl -n standby`/`hdparm` calls (internal/disk/linux_provider.go).
    #
    # preinst already wrote the durable drop-in below before
    # smartmontools' own postinst ran (safety-critical review finding on
    # #171: this postinst runs too late to stop that start from ever
    # happening), so the mask/stop/drop-in-write here are cleanup and
    # upgrade protection — for a smartmontools already running from
    # before hoserva was installed, and for every future hoserva
    # reconfigure — not what closes the original race.
    #
    # Masking blocks the unit right now, including a manual `systemctl
    # start` — but it does NOT survive a future smartmontools upgrade:
    # smartmontools 7.4-3's own postinst (dh_installsystemd) opens with
    # `deb-systemd-helper unmask smartmontools.service`, which deletes
    # this exact mask symlink, before re-enabling and restarting the
    # unit. The drop-in below is what actually survives that: `unmask`
    # only ever touches the unit's own mask symlink, never a
    # `.service.d/` override directory, so a condition placed there
    # keeps the unit from starting — enabled or not — across any future
    # smartmontools reinstall or upgrade.
    #
    # deb-systemd-helper/deb-systemd-invoke (init-system-helpers) are used
    # instead of systemctl directly so this is safe under a chroot build
    # with no systemd running, per Debian policy for maintainer scripts.
    if command -v deb-systemd-helper >/dev/null 2>&1; then
      deb-systemd-helper mask smartmontools.service >/dev/null || true
      deb-systemd-invoke stop smartmontools.service >/dev/null || true
    fi

    dropin_dir="$root/etc/systemd/system/smartmontools.service.d"
    mkdir -p "$dropin_dir"
    cat >"$dropin_dir/hoserva-disable.conf" <<'UNIT'
[Unit]
# Hoserva depends on smartmontools for smartctl/hdparm only (D1) and
# never wants its bundled smartd daemon running unmanaged (doc 08 §1).
# /nonexistent-hoserva-smartd-disabled is never created, so this
# condition always fails and systemd skips starting the unit instead of
# running it — including after a future smartmontools reinstall or
# upgrade unmasks and re-enables it, because that only ever touches the
# plain mask symlink above, never this override directory.
ConditionPathExists=/nonexistent-hoserva-smartd-disabled
UNIT

    # packaging/debian/hoserva-storage.rules (doc 02 §1, Q69, issue #372):
    # a fresh install's rule file is useless to a udev daemon that never
    # re-reads it, and an upgrade replacing an already-installed version
    # needs the same reload. Skipped under HOSERVA_TEST_ROOT (no real
    # udev to reload against a throwaway tree) and where udevadm itself
    # is missing (a chroot build with no udev running, the same reasoning
    # the deb-systemd-helper calls above already apply).
    if [ -z "$root" ] && command -v udevadm >/dev/null 2>&1; then
      udevadm control --reload-rules >/dev/null 2>&1 || true
    fi
    ;;
esac

#DEBHELPER#

exit 0
