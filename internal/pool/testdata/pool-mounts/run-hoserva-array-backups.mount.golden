[Unit]
Description=Hoserva share backups — mover write target
ConditionPathExists=!/var/lib/hoserva/array-stopped
RequiresMountsFor=/run/hoserva/branches/mnt/disk1 /run/hoserva/branches/mnt/disk2 /run/hoserva/branches/mnt/disk3

[Mount]
What=/run/hoserva/branches/mnt/disk1/backups=RW:/run/hoserva/branches/mnt/disk2/backups=RW:/run/hoserva/branches/mnt/disk3/backups=RW
Where=/run/hoserva/array/backups
Type=fuse.mergerfs
Options=category.create=ff,moveonenospc=true,dropcacheonclose=true,minfreespace=50G,cache.files=partial,cache.entry=1,cache.attr=1,cache.negative_entry=1,cache.statfs=0,fsname=hoserva-backups
