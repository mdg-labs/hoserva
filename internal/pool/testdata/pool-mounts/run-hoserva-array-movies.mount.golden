[Unit]
Description=Hoserva share movies — mover write target
ConditionPathExists=!/var/lib/hoserva/array-stopped
RequiresMountsFor=/run/hoserva/branches/mnt/disk1 /run/hoserva/branches/mnt/disk2 /run/hoserva/branches/mnt/disk3

[Mount]
What=/run/hoserva/branches/mnt/disk1/movies=RW:/run/hoserva/branches/mnt/disk2/movies=RW:/run/hoserva/branches/mnt/disk3/movies=RW
Where=/run/hoserva/array/movies
Type=fuse.mergerfs
Options=category.create=mspmfs,moveonenospc=true,dropcacheonclose=true,minfreespace=50G,cache.files=partial,cache.entry=1,cache.attr=1,cache.negative_entry=1,cache.statfs=0,fsname=hoserva-movies
