{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mdg-labs/hoserva/main/internal/template/schema/v1.json",
  "properties": {
    "schema": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Schema version of this block. A newer Hoserva keeps reading older versions."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Template id. Equals the name of the directory holding compose.yaml."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Increases with every change to the template."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Name shown in the catalog."
    },
    "categories": {
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Catalog categories."
    },
    "icon": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "File name of the icon next to compose.yaml. Omitted only when no usable icon exists; Hoserva then shows a built-in placeholder."
    },
    "docs": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Upstream documentation the template was written from."
    },
    "maintainer": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "description": "Who maintains the template or the app. Shown in the catalog and used as a filter."
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1,
      "description": "Longer plain-text description shown on the template's page. Line breaks are kept; nothing is interpreted as markup."
    },
    "screenshots": {
      "items": {
        "type": "string",
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*[.](png|webp|jpg|jpeg)$"
      },
      "type": "array",
      "maxItems": 8,
      "minItems": 1,
      "uniqueItems": true,
      "description": "Image files of the template's directory as paths relative to compose.yaml (PNG or WebP or JPEG files). No segment may start with a dot."
    },
    "links": {
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://",
          "description": "The app's project page."
        },
        "support": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://",
          "description": "Where to get help with the app."
        },
        "donate": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://",
          "description": "Where to support the app's development."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Where to find the app's project page and ways to support it. Every link is an https address."
    },
    "webui": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Address of the app's web interface. {host} stands for the server's address and ${INPUT} for an input."
    },
    "inputs": {
      "additionalProperties": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "path",
              "port",
              "string",
              "secret",
              "timezone",
              "device"
            ],
            "description": "What the value is."
          },
          "role": {
            "type": "string",
            "enum": [
              "appdata",
              "share",
              "media",
              "downloads",
              "gpu"
            ],
            "description": "Required for path (appdata/share/media/downloads) and device (gpu) inputs; not allowed for other kinds."
          },
          "default": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Preset value. A secret has none; it is generated at install time."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Plain-language name shown in the install form."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Help text shown in the install form."
          },
          "format": {
            "type": "string",
            "enum": [
              "hex",
              "laravel-key"
            ],
            "description": "Only for secret inputs: the shape of a generated value. hex (the default) is 48 hexadecimal characters; laravel-key is base64: followed by 32 random bytes in base64 - the APP_KEY of a Laravel application. A value typed for a laravel-key secret must have the same shape; any value is accepted for hex."
          },
          "optional": {
            "type": "boolean",
            "description": "Only for string inputs: the value may be left empty and is then written to .env as an empty value. An optional input has no default."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "path"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "default": {
                  "pattern": "^/",
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "appdata",
                    "share",
                    "media",
                    "downloads"
                  ]
                }
              },
              "required": [
                "role"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "device"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "role": {
                  "const": "gpu"
                }
              },
              "required": [
                "role"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "port",
                    "string",
                    "secret",
                    "timezone"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "role"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "port"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "default": {
                  "maximum": 65535,
                  "minimum": 1,
                  "type": "integer"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "secret"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "default"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "path",
                    "port",
                    "secret",
                    "timezone",
                    "device"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "optional"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "path",
                    "port",
                    "string",
                    "timezone",
                    "device"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "format"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "optional": {
                  "const": true
                }
              },
              "required": [
                "optional"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "default"
                ]
              }
            }
          }
        ]
      },
      "type": "object",
      "description": "The only values the install form asks for. Each key is a variable name. Every input except a device input must be used: referenced as ${NAME} in the Compose file or the webui address; or passed to a service through env_file: .env. A device input needs no reference.",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema",
    "id",
    "revision",
    "title",
    "categories",
    "docs"
  ],
  "title": "Hoserva x-hoserva template block, schema version 1"
}
