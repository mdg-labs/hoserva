#!/bin/sh
# DCO sign-off (CONTRIBUTING.md, doc 13 Q2). Installed via `make
# hooks-install` (core.hooksPath) and by the orchestrate skill's scratch
# clone step, so every commit in this repo picks it up automatically —
# human or agent, interactive or scratch clone.
set -eu

msg_file="$1"

# `git var GIT_AUTHOR_IDENT` resolves the identity this commit will
# actually carry — honoring GIT_AUTHOR_NAME/GIT_AUTHOR_EMAIL overrides
# before falling back to user.name/user.email — where `git config
# user.*` alone would not: a committer with those env vars set would
# then get a trailer for the wrong identity, which check-dco.sh rejects
# as a mismatch against the real author email (%ae).
ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)"
name="$(printf '%s\n' "$ident" | sed -n 's/^\(.*\) <.*$/\1/p')"
email="$(printf '%s\n' "$ident" | sed -n 's/^.* <\([^>]*\)>.*$/\1/p')"
[ -n "$name" ] && [ -n "$email" ] || exit 0

trailer="Signed-off-by: $name <$email>"
grep -qF "$trailer" "$msg_file" && exit 0

printf '\n%s\n' "$trailer" >> "$msg_file"
