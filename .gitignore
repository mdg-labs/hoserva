# Build output
/bin/
/dist/
*.deb

# The loop-device lab's per-lab image and mount roots (doc 06 §9, doc 12 §2) —
# owned by root once the lab container touches them, so they are never
# committed and must be destroyed with `make lab-destroy`, never `rm -rf`.
.lab/

# Corpora fetched at test or build time rather than committed. The
# project-authored corpora (testdata/parsers/, testdata/unraid-templates/,
# testdata/configs/) are committed and are not covered by this rule.
scripts/vm/images/
*.qcow2
*.iso

# Go
*.test

# Node (web/, api/'s tooling — Q63)
web/node_modules/
web/dist/
api/node_modules/

# Editors and OS
.DS_Store
