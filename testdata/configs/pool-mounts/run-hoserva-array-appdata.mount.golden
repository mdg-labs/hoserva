[Unit]
Description=Hoserva share appdata — mover write target
RequiresMountsFor=/mnt/disk1 /mnt/disk2 /mnt/disk3

[Mount]
What=/mnt/disk1/appdata=RW:/mnt/disk2/appdata=RW:/mnt/disk3/appdata=RW
Where=/run/hoserva/array/appdata
Type=fuse.mergerfs
Options=category.create=mfs,moveonenospc=true,dropcacheonclose=true,minfreespace=50G,cache.files=partial,cache.entry=1,cache.attr=1,cache.negative_entry=1,cache.statfs=0,fsname=hoserva-appdata
