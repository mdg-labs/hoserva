# Unraid 7.3 with its boot device inside the server (doc 08 §2, "Unraid 7.3 internal
# boot"): no USB stick. One device, target disk4, is laid out the way Unraid's
# mkbootable lays it out: GPT, 1 BIOS boot, 2 FAT32 EFI system partition,
# 3 the ZFS pool "flash" (dataset flash/boot holds the flash tree), 4 the data area. This is
# the dedicated boot pool: partition 4 is the 1 MiB mkbootable leaves and carries no
# filesystem. Beside it, a three-disk XFS array with single parity and no cache.
# The Flash Backup zip is the only configuration source (Q25).
#
# Building it needs OpenZFS, which the lab container does not have: this variant
# builds in the L3 guest only.
unraid_version=7.3.2
unraid_release=2026-09-10
expect_parity_signature=xfs
disk parity kind=parity fs=none  size=384M  target=parity1
disk disk1  kind=data   fs=xfs   size=320M  target=disk1
disk disk2  kind=data   fs=xfs   size=320M  target=disk2
disk disk3  kind=data   fs=xfs   size=320M  target=disk3
disk boot   kind=boot   fs=none  size=6144M target=disk4 boot=dedicated
# Regenerate flash/config/hoserva/ (the Phase A capture) with: make vm-unraid-capture VARIANT=unraid-internal-boot
include ../common/spec-flash
